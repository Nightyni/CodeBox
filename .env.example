# Copy to `.env` and fill in real values. NEVER commit the filled-in file.
#
# DeepSeek chat model (required for AI tagging + Q&A; without it the app still
# runs and falls back to keyword search).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: DeepSeek has no public embedding endpoint. To get true semantic
# retrieval, point the app at any OpenAI-compatible embedding provider, e.g.
#   SiliconFlow:  CODEBOX_EMBEDDING_MODEL=BAAI/bge-m3
#                 CODEBOX_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   DashScope:    CODEBOX_EMBEDDING_MODEL=text-embedding-v3
#                 CODEBOX_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Leave blank to use the built-in local hashing vectorizer.
CODEBOX_EMBEDDING_MODEL=
CODEBOX_EMBEDDING_BASE_URL=
CODEBOX_EMBEDDING_API_KEY=
